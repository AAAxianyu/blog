[Unit]
Description=x1anyu Next.js blog
After=network.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/srv/x1anyu-blog/current
EnvironmentFile=/etc/x1anyu-blog.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/x1anyu-blog

[Install]
WantedBy=multi-user.target
